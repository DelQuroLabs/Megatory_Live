{
  "name": "vetcount-inventory",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scheme": "vetcount",
  "slug": "vetcount-inventory",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx || echo 'lint not configured'",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~52.0.46",
    "expo-camera": "~16.0.18",
    "expo-constants": "~17.0.8",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.12",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.20",
    "expo-sharing": "~13.0.1",
    "expo-status-bar": "~2.0.1",
    "query-string": "^9.5.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~18.3.12",
    "jest": "~29.7.0",
    "typescript": "^5.3.3"
  },
  "expo": {
    "name": "VetCount",
    "slug": "vetcount-inventory",
    "scheme": "vetcount",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f766e"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Scan medication barcodes for inventory counting"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f766e"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow VetCount to scan medication barcodes"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  },
  "private": true
}
