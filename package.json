{
  "name": "megatory-live",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:offline": "expo start --web --offline",
    "build:web": "expo export --platform web",
    "preview": "node scripts/serve-preview.mjs preview 8081",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx || echo 'lint not configured'",
    "test": "jest",
    "test:domain": "jest --selectProjects domain",
    "test:components": "jest --selectProjects components"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "expo": "~52.0.46",
    "expo-camera": "~16.0.18",
    "expo-constants": "~17.0.8",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.12",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.20",
    "expo-sharing": "~13.0.1",
    "expo-status-bar": "~2.0.1",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~18.3.12",
    "jest": "~29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "typescript": "^5.3.3"
  },
  "private": true
}
